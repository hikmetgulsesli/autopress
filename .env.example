# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autopress

# JWT Secret (generate a strong random string)
JWT_SECRET=your-jwt-secret-here-min-32-characters

# OpenAI API Key (for content generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Unsplash API Key (for image search)
# Get your free API key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# CORS Origin (for development)
CORS_ORIGIN=http://localhost:3519

# Server Port
PORT=4519
