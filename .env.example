# ============================================
# AutoPress Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================

# --------------------------------------------
# REQUIRED: Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/autopress

# --------------------------------------------
# REQUIRED: JWT Authentication Secrets
# --------------------------------------------
# JWT_SECRET: Used for signing access tokens
# - MUST be at least 32 characters long
# - Use a cryptographically secure random string
# - Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-min-32-characters-long

# JWT_REFRESH_SECRET: Used for signing refresh tokens
# - Should be different from JWT_SECRET
# - Use a cryptographically secure random string
JWT_REFRESH_SECRET=your-refresh-secret-here-different-from-jwt-secret

# --------------------------------------------
# REQUIRED: CORS Configuration
# --------------------------------------------
# CORS_ORIGIN: Allowed origin for frontend requests
# For development:
CORS_ORIGIN=http://localhost:3519
# For production (example):
# CORS_ORIGIN=https://autopress.yourdomain.com

# --------------------------------------------
# OPTIONAL: Server Configuration
# --------------------------------------------
# PORT: Server port (default: 4519)
PORT=4519

# --------------------------------------------
# OPTIONAL: External API Keys
# --------------------------------------------
# OpenAI API Key (for AI content generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Unsplash API Key (for image search)
# Get your free API key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# --------------------------------------------
# Password Policy (Hardcoded in config.ts)
# --------------------------------------------
# The following password requirements are enforced:
# - Minimum 12 characters
# - At least one uppercase letter (A-Z)
# - At least one lowercase letter (a-z)
# - At least one number (0-9)
# - At least one special character (@$!%*?&)
# --------------------------------------------
