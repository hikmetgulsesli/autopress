# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autopress

# JWT Authentication
JWT_SECRET=your-jwt-secret-min-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Unsplash API (Free tier: 50 requests/hour)
# Get your access key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google OAuth (for Blogger integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# WordPress API (optional)
WP_DEFAULT_USER=wordpress-username

# CORS
CORS_ORIGIN=http://localhost:3519

# Server
PORT=4519
